{
  "name": "concepts-parser",
  "version": "1.5.6",
  "description": "Concepts Extracting from text",
  "main": "./lib/index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "pretest": "npm run normalize-data",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf lib types",
    "clean-code": "rimraf --glob \"lib/**/*.test.js\" \"types/**/*.test.d.ts\" \"types/scripts\"",
    "normalize-data": "tsx src/scripts/normalize-data.ts",
    "build-invalid-concepts": "tsx src/scripts/build-invalid-concepts.ts",
    "build-firstnames": "tsx src/scripts/build-firstnames.ts",
    "build-connect-words": "tsx src/scripts/build-connect-words.ts",
    "build": "npm run clean && tsc",
    "preversion": "npm run typecheck && npm test",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run clean-code"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/entitizer/concepts-parser-js.git"
  },
  "keywords": [
    "concept",
    "extractor",
    "nlp",
    "extraction",
    "entity",
    "token",
    "parser"
  ],
  "author": "Dumitru Cantea",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/entitizer/concepts-parser-js/issues"
  },
  "homepage": "https://github.com/entitizer/concepts-parser-js",
  "dependencies": {
    "atonic": "^1.x.x",
    "debug": "^4.4.3",
    "is-abbr-of": "^0.1.2"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "^5.0.4",
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.1.2",
    "fs-extra": "^7.0.1",
    "node-fetch": "^2.3.0",
    "rimraf": "^6.1.3",
    "stopwords-json": "^1.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
