{
  "name": "concepts-parser",
  "version": "1.5.6",
  "description": "Concepts Extracting from text",
  "main": "./lib/index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "pretest": "npm run clean && npm run tsc && npm run normalize-data",
    "test": "ava --no-cache",
    "posttest": "npm run clean-code",
    "tsc": "tsc",
    "tscw": "tsc -w",
    "preversion": "npm run tsc",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "npm run tsc && npm run clean-code",
    "clean": "rimraf lib types",
    "clean-code": "rimraf --glob \"lib/**/*.test.js\" \"types/**/*.test.d.ts\" \"types/scripts\"",
    "build-invalid-concepts": "node ./lib/scripts/build-invalid-concepts.js",
    "build-firstnames": "node ./lib/scripts/build-firstnames.js",
    "build-connect-words": "node ./lib/scripts/build-connect-words.js",
    "normalize-data": "node ./lib/scripts/normalize-data.js",
    "build": "tsc && npm run build-invalid-concepts && npm run build-firstnames && npm run build-connect-words"
  },
  "engines": {
    "node": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/entitizer/concepts-parser-js.git"
  },
  "keywords": [
    "concept",
    "extractor",
    "nlp",
    "extraction",
    "entity",
    "token",
    "parser"
  ],
  "author": "Dumitru Cantea",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/entitizer/concepts-parser-js/issues"
  },
  "homepage": "https://github.com/entitizer/concepts-parser-js",
  "dependencies": {
    "atonic": "^1.x.x",
    "debug": "^4.4.3",
    "is-abbr-of": "^0.1.2"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "^5.0.4",
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.1.2",
    "ava": "^3.0.0",
    "fs-extra": "^7.0.1",
    "node-fetch": "^2.3.0",
    "rimraf": "^6.1.3",
    "stopwords-json": "^1.2.0",
    "typescript": "^7.0.2"
  }
}
