{
  "name": "concepts-parser",
  "version": "2.0.0",
  "description": "Concepts Extracting from text",
  "main": "./lib/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "types",
    "data",
    "CHANGELOG.md"
  ],
  "scripts": {
    "pretest": "npm run normalize-data",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf lib types",
    "normalize-data": "tsx src/scripts/normalize-data.ts",
    "build-invalid-concepts": "tsx src/scripts/build-invalid-concepts.ts",
    "build-firstnames": "tsx src/scripts/build-firstnames.ts",
    "build-connect-words": "tsx src/scripts/build-connect-words.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "preversion": "npm run typecheck && npm test",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format-check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/entitizer/concepts-parser-js.git"
  },
  "keywords": [
    "concept",
    "extractor",
    "nlp",
    "extraction",
    "entity",
    "token",
    "parser"
  ],
  "author": "Dumitru Cantea",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/entitizer/concepts-parser-js/issues"
  },
  "homepage": "https://github.com/entitizer/concepts-parser-js",
  "dependencies": {
    "atonic": "^1.x.x",
    "debug": "^4.4.3",
    "is-abbr-of": "^0.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "stopwords-json": "^1.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
